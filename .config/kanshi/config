profile home {
  outputs = DP-5, DP-7
	output eDP-1 disable
	output DP-5 mode 1920x1080 position 0,0
	output DP-7 mode 1920x1080 position 1920,0
}

profile laptop {
  outputs = eDP-1
	output eDP-1 enable mode 1920x1080 position 0,0 scale 1
}

profile standalone {
  output eDP-1 enable mode 1920x1080 position 0,0 scale 1
}

profile kth {
	output eDP-1 mode 1920x1080 position 0,1080 scale 1
	output DP-3 mode 1920x1080 position 0,0
}
